     #[serde(default)] pub lagrangian: LagrangianDef,
     #[serde(default)] pub solver: SolverDef,
     pub entities: Vec<EntityRef>,
+    // <reason>Harmonic bonds between entities (world indices = entity emission order)</reason>
+    #[serde(default)] pub bonds: Vec<BondDef>,
     // <reason>NEW: Physics preset + SM parameters for Lagrangian-first architecture</reason>
     // <reason>If present, overrides legacy ad-hoc coupling values in lagrangian.interactions</reason>
