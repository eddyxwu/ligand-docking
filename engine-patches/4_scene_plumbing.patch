                     next_nucleus_id += 1;
                 }
             } else if !entity.particle.is_empty() {
+                let idx = world.len();
                 self.add_particle(&mut world, &entity.particle, &entity.color,
                     Vec3::from_array(entity.position), Vec3::from_array(entity.velocity));
+                // <reason>Optional molecule grouping: entities with the same "group" value</reason>
