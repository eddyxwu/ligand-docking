+    /// <reason>Alpha blend (lerp) over background - for antialiased opaque edges</reason>
+    fn blend_alpha_safe(&mut self, x: i32, y: i32, r: u32, g: u32, b: u32, alpha: f64) {
+        let sw = self.scene_width_px() as i32;
+        let sh = self.h as i32;
+        if x < 0 || x >= sw || y < 0 || y >= sh { return; }
+        let idx = y as usize * self.w + x as usize;
+        if idx >= self.buf.len() { return; }
+
