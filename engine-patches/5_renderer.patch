+    /// <reason>Shaded classical sphere for coarse-grained/classical particles (has_qdesic = false)</reason>
+    /// <reason>Physically honest: no quantum probability cloud is drawn, because for heavy</reason>
+    /// <reason>classical objects λ_deBroglie = ħ/p ≈ 0 - there is no visible uncertainty.</reason>
+    /// <reason>Instead: solid occluding sphere (molecular space-fill representation) that</reason>
+    /// <reason>shares the engine's visual language - Lambert shading, soft specular core,</reason>
+    /// <reason>antialiased edge, subtle additive halo, and circle()'s depth dimming.</reason>
+    fn render_classical_sphere(&mut self, cx: i32, cy: i32, z: f64, radius: i32, color: u32) {
+        let sw = self.scene_width_px() as i32;
+        let sh = self.h as i32;
+        let r_f = radius as f64;
+        if r_f < 1.0 { return; }
+
+        // <reason>Gentler depth dimming than circle(): classical scenes sit at larger camera</reason>
+        // <reason>distances than fm-scale quantum scenes, so circle()'s 0.15/px slope pins</reason>
+        // <reason>everything to its 0.3 floor. Slope 0.04 + floor 0.55 keeps depth cueing</reason>
+        // <reason>while matching the brightness of the engine's cloud-rendered scenes.</reason>
+        let depth_bright = (1.0 - (z - 1.0).max(0.0) * 0.04).max(0.55);
+
+        let cr = ((color >> 16) & 0xFF) as f64;
+        let cg = ((color >> 8) & 0xFF) as f64;
+        let cb = (color & 0xFF) as f64;
+
+        // <reason>Fixed light: upper-left, toward viewer (matches the engine's soft look)</reason>
+        const LX: f64 = -0.42;
+        const LY: f64 = -0.57;
+        const LZ: f64 = 0.71;
+        // <reason>Half-vector of light + view (0,0,1) for Blinn specular, precomputed</reason>
+        const HX: f64 = -0.24;
+        const HY: f64 = -0.33;
+        const HZ: f64 = 0.91;
+
+        // <reason>Additive halo just outside the edge: ties into the cloud glow language</reason>
+        let halo_ext = (r_f * 0.30).clamp(2.0, 9.0);
+        let r_ext = radius + halo_ext.ceil() as i32 + 1;
+
+        for dy in -r_ext..=r_ext {
+            let py = cy + dy;
+            if py < 0 || py >= sh { continue; }
+            for dx in -r_ext..=r_ext {
+                let px = cx + dx;
+                if px < 0 || px >= sw { continue; }
+                let d = ((dx * dx + dy * dy) as f64).sqrt();
+
+                if d <= r_f {
+                    // <reason>Implied sphere normal: n_z = sqrt(1 - (d/r)²)</reason>
+                    let nx = dx as f64 / r_f;
+                    let ny = dy as f64 / r_f;
+                    let nz = (1.0 - (nx * nx + ny * ny)).max(0.0).sqrt();
+
+                    // <reason>Lambert diffuse + ambient floor (keeps dark side readable)</reason>
+                    let lambert = (nx * LX + ny * LY + nz * LZ).max(0.0);
+                    let shade = 0.38 + 0.62 * lambert;
+
+                    // <reason>Soft Blinn specular: the white-hot center echo of the cloud cores</reason>
+                    let spec = (nx * HX + ny * HY + nz * HZ).max(0.0).powi(14) * 0.40;
