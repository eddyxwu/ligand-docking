+                    let rr = ((cr * shade + 255.0 * spec) * depth_bright).min(255.0) as u32;
+                    let gg = ((cg * shade + 255.0 * spec) * depth_bright).min(255.0) as u32;
+                    let bb = ((cb * shade + 255.0 * spec) * depth_bright).min(255.0) as u32;
+
+                    // <reason>Antialiased rim: soft opaque edge over ~1.5px, like the clouds</reason>
